<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="130dp">
            <View android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bg_header_rounded"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="12dp" android:paddingEnd="24dp" android:paddingTop="24dp">
                <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp"
                    android:src="@android:drawable/ic_media_previous"
                    android:background="@drawable/bg_avatar_circle"
                    android:tint="@color/white" android:contentDescription="Regresar"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Nueva Cita"
                    android:textColor="@color/white" android:textSize="22sp"
                    android:textStyle="bold" android:gravity="center"/>
                <View android:layout_width="44dp" android:layout_height="44dp"/>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Step 1: Servicio -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="18dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                            android:background="@drawable/bg_step_circle">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="1" android:textColor="@color/white"
                                android:textSize="14sp" android:textStyle="bold"
                                android:layout_gravity="center"/>
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Selecciona el servicio"
                            android:textSize="16sp" android:textStyle="bold"
                            android:textColor="@color/text_primary" android:layout_marginStart="10dp"/>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilServicio"
                        style="@style/DentalInputLayout" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="@string/select_service">
                        <AutoCompleteTextView android:id="@+id/spinnerServicio"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:gravity="center_vertical"
                            android:textSize="15sp"
                            android:textColor="#1C2B3A"
                            android:inputType="none"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Duración estimada del servicio -->
                    <TextView
                        android:id="@+id/tvDuracionServicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="@color/cyan_dark"
                        android:fontFamily="sans-serif-medium"
                        android:visibility="gone"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Step 2: Fecha -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="18dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                            android:background="@drawable/bg_step_circle">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="2" android:textColor="@color/white"
                                android:textSize="14sp" android:textStyle="bold"
                                android:layout_gravity="center"/>
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Selecciona la fecha"
                            android:textSize="16sp" android:textStyle="bold"
                            android:textColor="@color/text_primary" android:layout_marginStart="10dp"/>
                    </LinearLayout>

                    <!-- Fecha seleccionada mostrada -->
                    <TextView
                        android:id="@+id/tvFechaSeleccionada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Toca para seleccionar fecha"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSeleccionarFecha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:text="Seleccionar Fecha"
                        android:textSize="15sp"
                        style="@style/DentalButton.Outline"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Step 3: Hora -->
            <androidx.cardview.widget.CardView android:id="@+id/cardHorarios"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="@color/white"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="18dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                            android:background="@drawable/bg_step_circle">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="3" android:textColor="@color/white"
                                android:textSize="14sp" android:textStyle="bold"
                                android:layout_gravity="center"/>
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Selecciona el horario"
                            android:textSize="16sp" android:textStyle="bold"
                            android:textColor="@color/text_primary" android:layout_marginStart="10dp"/>
                    </LinearLayout>

                    <!-- Leyenda -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <View android:layout_width="12dp" android:layout_height="12dp"
                            android:background="@drawable/bg_slot_available" android:layout_marginTop="2dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text=" Disponible" android:textSize="12sp"
                            android:textColor="@color/text_secondary" android:layout_marginEnd="16dp"/>
                        <View android:layout_width="12dp" android:layout_height="12dp"
                            android:background="@drawable/bg_slot_occupied" android:layout_marginTop="2dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text=" Ocupado" android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>
                    </LinearLayout>

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressSlots" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_gravity="center"
                        android:visibility="gone" app:indicatorColor="@color/cyan_primary"/>

                    <com.google.android.flexbox.FlexboxLayout android:id="@+id/flexboxHorarios"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        app:flexWrap="wrap" app:alignItems="flex_start"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Step 4: Notas -->
            <androidx.cardview.widget.CardView android:id="@+id/cardNotas"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="@color/white"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Notas adicionales (opcional)"
                        android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" android:layout_marginBottom="10dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/DentalInputLayout" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="Ej. Tengo sensibilidad en el diente...">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNotas"
                            android:layout_width="match_parent"
                        android:textColor="#1C2B3A" android:layout_height="wrap_content"
                            android:inputType="textMultiLine" android:lines="3" android:maxLines="5"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Resumen (solo se muestra cuando todo está listo) -->
            <androidx.cardview.widget.CardView android:id="@+id/cardResumen"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp" app:cardElevation="4dp"
                app:cardBackgroundColor="@color/cyan_extra_light"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Resumen de tu cita" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="@color/cyan_dark"
                        android:layout_marginBottom="12dp"/>
                    <TextView android:id="@+id/tvResumenServicio"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/tvResumenFecha"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"/>
                    <TextView android:id="@+id/tvResumenHora"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botón Confirmar siempre visible al fondo -->
            <com.google.android.material.button.MaterialButton android:id="@+id/btnConfirmar"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="Confirmar Cita"
                android:textSize="15sp" android:textStyle="bold"
                android:layout_marginBottom="80dp"
                style="@style/DentalButton.Primary"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
