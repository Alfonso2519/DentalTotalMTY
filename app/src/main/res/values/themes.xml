<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ═══════════════════════════════════
         TEMA PRINCIPAL
    ═══════════════════════════════════ -->
    <style name="Theme.DentalTotalMTY" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cyan_primary</item>
        <item name="colorPrimaryVariant">@color/cyan_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/navy_primary</item>
        <item name="colorSecondaryVariant">@color/navy_mid</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/cyan_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.DentalTotalMTY.Splash" parent="Theme.DentalTotalMTY">
        <item name="android:statusBarColor">@color/cyan_primary</item>
    </style>

    <!-- ═══════════════════════════════════
         INPUT FIELDS
    ═══════════════════════════════════ -->
    <style name="DentalInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/cyan_primary</item>
        <item name="hintTextColor">@color/cyan_dark</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <!-- FIX: texto escrito por el usuario siempre negro legible -->
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <!-- ═══════════════════════════════════
         BOTONES
    ═══════════════════════════════════ -->
    <style name="DentalButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/cyan_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DentalButton.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/cyan_primary</item>
        <item name="android:textColor">@color/cyan_dark</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DentalButton.Navy" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/navy_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DentalButton.Danger" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/error_red</item>
        <item name="android:textColor">@color/error_red</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ═══════════════════════════════════
         CARDS
    ═══════════════════════════════════ -->
    <style name="DentalCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="DentalCard.Elevated" parent="DentalCard">
        <item name="cardElevation">10dp</item>
    </style>

    <!-- ═══════════════════════════════════
         CHIPS
    ═══════════════════════════════════ -->
    <style name="StatusChip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">26dp</item>
        <item name="chipIconVisible">false</item>
        <item name="closeIconVisible">false</item>
    </style>

    <!-- ═══════════════════════════════════
         TEXT APPEARANCES
    ═══════════════════════════════════ -->
    <style name="TextAppearance.Dental.H1" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Dental.H2" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Dental.H3" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Dental.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Dental.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Dental.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Dental.Header.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.Dental.Header.Subtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/white_70</item>
    </style>

    <!-- ═══════════════════════════════════
         BOTTOM NAV
    ═══════════════════════════════════ -->
    <style name="DentalBottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="elevation">10dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- ═══════════════════════════════════
         DIALOGS
    ═══════════════════════════════════ -->
    <style name="DentalDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/DentalDialog.Shape</item>
    </style>

    <style name="DentalDialog.Shape" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>


    <!-- DatePicker con botones visibles -->
    <style name="DentalDatePicker" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorPrimary">@color/cyan_primary</item>
        <item name="colorAccent">@color/cyan_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:buttonBarButtonStyle">@style/DentalDatePicker.Button</item>
    </style>

    <style name="DentalDatePicker.Button" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:textColor">@color/cyan_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
